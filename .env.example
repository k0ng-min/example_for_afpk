# FINOVA 환경 변수 예시 — 복사해서 .env 로 사용 (.env 는 git 에 올리지 않음)
FINOVA_ENV=development
PORT=8080
DATABASE_URL=sqlite://finova.db?mode=rwc
# Idea Configuration Studio / 주제 전환 보호. 배포 시 길고 무작위한 값으로 반드시 변경
ADMIN_TOKEN=change-me-to-a-long-random-string
FINOVA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 선택: Gemini 연동 — 키가 있으면 AI 상담 답변을 Gemini 가 작성(서버에서만 호출). 프론트엔드에 넣지 말 것
# 키 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# 주 모델이 붐비면(503) 자동으로 쓰는 예비 모델. none 이면 사용 안 함
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
# ANTHROPIC_API_KEY 는 감지만 하고 호출하지 않는다
ANTHROPIC_API_KEY=
RUST_LOG=info,tower_http=info,sqlx=warn
