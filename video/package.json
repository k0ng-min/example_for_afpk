{
  "name": "finova-video",
  "private": true,
  "version": "0.1.0",
  "description": "FINOVA 공통 제품 소개영상 템플릿 (Remotion). 웹앱과 분리된 영상 전용 프로젝트",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "snapshot": "node scripts/fetch-engine-snapshot.mjs",
    "check": "node scripts/check-timeline.mjs",
    "typecheck": "tsc --noEmit",
    "still": "node scripts/render-stills.mjs",
    "render": "remotion render src/index.ts FinovaPromo out/finova-promo.mp4 --codec h264 --crf 18",
    "render:idea": "node scripts/render-idea.mjs",
    "voice": "node scripts/make-narration.mjs cpa_gap"
  },
  "dependencies": {
    "@remotion/cli": "4.0.540",
    "@remotion/transitions": "4.0.540",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.540",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "typescript": "5.7.3"
  }
}
